# Copie este arquivo para .env e preencha com os valores do seu projeto.
# O .env está no .gitignore e NUNCA deve ser enviado ao repositório.
#
# Onde achar: painel do Supabase -> Project Settings -> API Keys

# O endereço do projeto. Aparece também em src/js/supabase.js.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# A chave PUBLISHABLE (sb_publishable_...).
# É pública por design e já está escrita em src/js/supabase.js.
# Fica aqui só por conveniência de scripts.
SUPABASE_ANON_KEY=sb_publishable_...

# A chave SECRETA (sb_secret_... ou service_role).
#
# ⚠️ Esta passa por cima de TODAS as regras de segurança do banco.
#    Só o servidor pode lê-la. Nunca coloque em nada dentro de src/,
#    nem em HTML, nem em JavaScript que o navegador baixe.
SUPABASE_SERVICE_KEY=sb_secret_...

# Porta do servidor Express.
PORT=3000
